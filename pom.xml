<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.8</version>
		<relativePath/>
	</parent>
	<groupId>com.example</groupId>
	<artifactId>flink-fraud-detection</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>flink-fraud-detection</name>
	<description>Apache Flink real-time fraud detection pipeline</description>

	<properties>
		<java.version>17</java.version>
		<flink.version>1.19.1</flink.version>
	</properties>

	<dependencies>
		<!-- ================================================================ -->
		<!-- Apache Flink                                                      -->
		<!-- ================================================================ -->
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-clients</artifactId>
			<version>${flink.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-streaming-java</artifactId>
			<version>${flink.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-connector-base</artifactId>
			<version>${flink.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-connector-kafka</artifactId>
			<version>3.2.0-1.19</version>
		</dependency>

		<!-- ================================================================ -->
		<!-- Spring Boot — no web server needed for a headless streaming job  -->
		<!-- ================================================================ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<!-- Use spring-boot-starter (not starter-web) to avoid pulling in -->
			<!-- Tomcat/Netty for a pure Flink streaming application.           -->
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<!-- ================================================================ -->
		<!-- JSON serialisation                                                -->
		<!-- ================================================================ -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>2.15.0</version>
		</dependency>

		<!-- ================================================================ -->
		<!-- Code generation                                                   -->
		<!-- =============================================================== -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- ================================================================ -->
		<!-- Test                                                              -->
		<!-- ================================================================ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  Provides ProcessFunctionTestHarnesses and KeyedOneInputStreamOperatorTestHarness
		  for unit-testing Flink operators without spinning up a MiniCluster.
		-->
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-test-utils</artifactId>
			<version>${flink.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Test-jar of flink-streaming-java exposes KeyedOneInputStreamOperatorTestHarness -->
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-streaming-java</artifactId>
			<version>${flink.version}</version>
			<classifier>tests</classifier>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
		<finalName>flink-fraud-detection</finalName>
	</build>

</project>
